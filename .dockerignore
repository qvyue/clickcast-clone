# Dependencies (rebuilt by npm ci)
node_modules

# Git
.git
.gitignore

# IDE
.idea
.vscode

# Generated video outputs (stored in runtime volume)
websites/*/out
out

# Website source data (generated at runtime)
websites/*/public

# Keep websites dir structure but not contents
websites/*/screenshots

# Frontend (built in Dockerfile, only exclude build artifacts)
frontend/node_modules
frontend/dist
frontend/test-results

# Test files
lib/__tests__
e2e
*.test.js
*.test.ts
*.spec.js
*.spec.ts
playwright.config.ts

# Claude Code
.claude

# Docker
Dockerfile
docker-compose*.yml

# Misc
*.log
*.tmp
.env
.env.*
!.env.example
