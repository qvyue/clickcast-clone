# AI 配置 (必填)
DEEPSEEK_API_KEY=your_api_key_here
API_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# TTS 配音配置 (必填 - ElevenLabs)
ELEVENLABS_API_KEY=your_elevenlabs_key
# 声音 ID（从 https://api.elevenlabs.io/v1/voices 获取）
ELEVENLABS_VOICE_ID=alFofuDn3cOwyoz1i44T

# 背景音乐音量 (0.0 - 1.0)
BGM_VOLUME=0.15

# 云存储配置 (可选 - Cloudflare R2)
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=your_access_key
# R2_SECRET_ACCESS_KEY=your_secret_key
# R2_BUCKET_NAME=your_bucket
# R2_PUBLIC_URL=https://your-domain.com

# 服务器配置
PORT=3000

# Supabase 认证配置 (必填 - Google OAuth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Stripe 支付配置 (沙箱测试 - 使用 sk_test_ 前缀的测试密钥)
STRIPE_SECRET_KEY=sk_test_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRO_PRICE_ID=price_your_pro_price_id
STRIPE_CREDIT_PACK_PRICE_ID=price_your_credit_pack_price_id
APP_URL=http://localhost:3000
